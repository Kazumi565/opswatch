# Copy to terraform.tfvars only for a short-lived AWS demo.
# The default remains create_infrastructure = false so validation creates nothing.

create_infrastructure = false
aws_region            = "us-east-1"
instance_type         = "t3.micro"
key_name              = "replace-with-existing-key-pair"
allowed_ssh_cidr      = "203.0.113.10/32"
root_volume_size_gb   = 20
opswatch_domain       = "opswatch.example.com"
